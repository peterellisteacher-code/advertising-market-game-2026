{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admarket.classroom.invalid/schemas/catalog-asset-v1.schema.json",
  "title": "Advertising Market catalogue asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "delivery",
    "id",
    "version",
    "kind",
    "title",
    "category",
    "tags",
    "files",
    "dimensions",
    "recolourZones",
    "anchors",
    "materialProfiles",
    "classroomReviewed",
    "brandFree",
    "attribution"
  ],
  "properties": {
    "schema": { "const": "catalog-asset@1" },
    "delivery": { "enum": ["offline", "live-photo"] },
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "const": 1 },
    "kind": {
      "enum": [
        "raster-master",
        "component",
        "svg",
        "texture",
        "shape",
        "photo",
        "shell"
      ]
    },
    "title": { "$ref": "#/$defs/title" },
    "category": { "$ref": "#/$defs/category" },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tag" }
    },
    "files": { "$ref": "#/$defs/files" },
    "masterSha256": { "$ref": "#/$defs/sha256" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "recolourZones": { "$ref": "#/$defs/zones" },
    "anchors": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/anchor" }
    },
    "materialProfiles": { "$ref": "#/$defs/materialProfiles" },
    "classroomReviewed": { "type": "boolean" },
    "brandFree": { "type": "boolean" },
    "attribution": { "$ref": "#/$defs/attribution" },
    "virtualParentId": { "$ref": "#/$defs/portableId" },
    "defaultZoneStyles": { "$ref": "#/$defs/zoneStyles" }
  },
  "allOf": [
    {
      "if": {
        "required": ["delivery"],
        "properties": { "delivery": { "const": "offline" } }
      },
      "then": {
        "required": ["masterSha256"],
        "properties": {
          "id": { "$ref": "#/$defs/portableId" },
          "dimensions": { "$ref": "#/$defs/offlineDimensions" },
          "files": {
            "properties": {
              "thumbnail": { "$ref": "#/$defs/offlineThumbnail" },
              "preview": { "$ref": "#/$defs/offlinePreview" },
              "master": { "$ref": "#/$defs/offlineMaster" },
              "masks": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "body": { "$ref": "#/$defs/offlineBodyMask" },
                  "trim": { "$ref": "#/$defs/offlineTrimMask" },
                  "accent": { "$ref": "#/$defs/offlineAccentMask" },
                  "label": { "$ref": "#/$defs/offlineLabelMask" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["delivery"],
        "properties": { "delivery": { "const": "live-photo" } }
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["masterSha256"] },
            { "required": ["virtualParentId"] },
            { "required": ["defaultZoneStyles"] }
          ]
        },
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "kind": { "const": "photo" },
          "files": {
            "not": { "required": ["masks"] },
            "properties": {
              "thumbnail": { "$ref": "#/$defs/liveThumbnail" },
              "preview": { "$ref": "#/$defs/liveFull" },
              "master": { "$ref": "#/$defs/liveFull" }
            }
          },
          "recolourZones": { "maxItems": 0 },
          "anchors": { "maxItems": 0 },
          "materialProfiles": { "maxItems": 0 },
          "classroomReviewed": { "const": false },
          "brandFree": { "const": false }
        }
      }
    },
    { "$ref": "#/$defs/bodyMaskAgreement" },
    { "$ref": "#/$defs/trimMaskAgreement" },
    { "$ref": "#/$defs/accentMaskAgreement" },
    { "$ref": "#/$defs/labelMaskAgreement" }
  ],
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!(?:con|prn|aux|nul|clock\\$|com[1-9]|lpt[1-9])$)[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "offlineDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "zone": { "enum": ["body", "trim", "accent", "label"] },
    "zones": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/zone" }
    },
    "materialProfile": {
      "enum": [
        "matte-plastic",
        "gloss-plastic",
        "rubber",
        "cardboard",
        "fabric",
        "glass",
        "brushed-metal",
        "wood"
      ]
    },
    "materialProfiles": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/materialProfile" }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "accepts"],
      "properties": {
        "id": { "$ref": "#/$defs/portableId" },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "accepts": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/portableId" }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "sourceUrl", "license"],
      "properties": {
        "creator": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sourceUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "license": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "zoneStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colour", "materialId", "opacity"],
      "properties": {
        "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "materialId": { "$ref": "#/$defs/materialProfile" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "zoneStyles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "body": { "$ref": "#/$defs/zoneStyle" },
        "trim": { "$ref": "#/$defs/zoneStyle" },
        "accent": { "$ref": "#/$defs/zoneStyle" },
        "label": { "$ref": "#/$defs/zoneStyle" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thumbnail", "preview", "master"],
      "properties": {
        "thumbnail": { "type": "string" },
        "preview": { "type": "string" },
        "master": { "type": "string" },
        "masks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": { "type": "string" },
            "trim": { "type": "string" },
            "accent": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "generatedRoot": {
      "type": "string",
      "pattern": "^/catalog/generated/(?:offline-core-v1|performance-fixtures)/assets/[a-z0-9]+(?:-[a-z0-9]+)*"
    },
    "offlineThumbnail": {
      "type": "string",
      "pattern": "^/catalog/generated/(?:offline-core-v1|performance-fixtures)/assets/[a-z0-9]+(?:-[a-z0-9]+)*/thumbnail-192\\.webp$"
    },
    "offlinePreview": {
      "type": "string",
      "pattern": "^/catalog/generated/(?:offline-core-v1|performance-fixtures)/assets/[a-z0-9]+(?:-[a-z0-9]+)*/preview-640\\.webp$"
    },
    "offlineMaster": {
      "type": "string",
      "pattern": "^/catalog/generated/(?:offline-core-v1|performance-fixtures)/assets/[a-z0-9]+(?:-[a-z0-9]+)*/master\\.png$"
    },
    "offlineBodyMask": {
      "type": "string",
      "pattern": "^/catalog/generated/(?:offline-core-v1|performance-fixtures)/assets/[a-z0-9]+(?:-[a-z0-9]+)*/masks/body\\.png$"
    },
    "offlineTrimMask": {
      "type": "string",
      "pattern": "^/catalog/generated/(?:offline-core-v1|performance-fixtures)/assets/[a-z0-9]+(?:-[a-z0-9]+)*/masks/trim\\.png$"
    },
    "offlineAccentMask": {
      "type": "string",
      "pattern": "^/catalog/generated/(?:offline-core-v1|performance-fixtures)/assets/[a-z0-9]+(?:-[a-z0-9]+)*/masks/accent\\.png$"
    },
    "offlineLabelMask": {
      "type": "string",
      "pattern": "^/catalog/generated/(?:offline-core-v1|performance-fixtures)/assets/[a-z0-9]+(?:-[a-z0-9]+)*/masks/label\\.png$"
    },
    "liveThumbnail": {
      "type": "string",
      "pattern": "^/api/openverse-image/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\?variant=thumbnail$"
    },
    "liveFull": {
      "type": "string",
      "pattern": "^/api/openverse-image/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "bodyMaskAgreement": {
      "if": {
        "properties": { "recolourZones": { "contains": { "const": "body" } } }
      },
      "then": {
        "properties": {
          "files": {
            "required": ["masks"],
            "properties": { "masks": { "required": ["body"] } }
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "properties": { "masks": { "not": { "required": ["body"] } } }
          }
        }
      }
    },
    "trimMaskAgreement": {
      "if": {
        "properties": { "recolourZones": { "contains": { "const": "trim" } } }
      },
      "then": {
        "properties": {
          "files": {
            "required": ["masks"],
            "properties": { "masks": { "required": ["trim"] } }
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "properties": { "masks": { "not": { "required": ["trim"] } } }
          }
        }
      }
    },
    "accentMaskAgreement": {
      "if": {
        "properties": { "recolourZones": { "contains": { "const": "accent" } } }
      },
      "then": {
        "properties": {
          "files": {
            "required": ["masks"],
            "properties": { "masks": { "required": ["accent"] } }
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "properties": { "masks": { "not": { "required": ["accent"] } } }
          }
        }
      }
    },
    "labelMaskAgreement": {
      "if": {
        "properties": { "recolourZones": { "contains": { "const": "label" } } }
      },
      "then": {
        "properties": {
          "files": {
            "required": ["masks"],
            "properties": { "masks": { "required": ["label"] } }
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "properties": { "masks": { "not": { "required": ["label"] } } }
          }
        }
      }
    }
  }
}
