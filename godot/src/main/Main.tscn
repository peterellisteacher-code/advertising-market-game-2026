[node name="InstructionsDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "Advertising campaign instructions"
initial_position = 1
size = Vector2i(920, 640)
ok_button_text = "Close"
dialog_hide_on_ok = true

[node name="InstructionsText" type="RichTextLabel" parent="InstructionsDialog"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -72.0
grow_horizontal = 2
grow_vertical = 2
focus_mode = 2
theme_override_font_sizes/normal_font_size = 17
bbcode_enabled = true
text = "[b]How to use this site[/b]\n\nUse these instructions at any time. The steps form an inductive argument: each completed step gives you a reason for the next judgement. The final conclusion is probable rather than guaranteed.\n\n[b]Start and return[/b]\n1. A saved campaign belongs to one pair and one practice or class-market session.\n2. Enter one pair alias on one MacBook. Then select Practice on this computer, or enter the room code supplied by your teacher.\n3. When you return, use the same route so the site can restore the correct campaign.\nSub-conclusion: the pair identity, session and saved campaign can be connected reliably.\n\n[b]Audience and product[/b]\n4. The connected campaign contains an audience brief with particular needs and values.\n5. A suitable product responds to at least one need or value in that brief.\n6. Give the product a distinctive name and place the product prominently so that the response is visible.\n7. Each partner must make a visible contribution: the Art Director changes an image and the Strategist changes a message, then the pair swaps roles.\nIntermediate conclusion 1: the completed product is likely to suit the stated audience.\n\n[b]Product and advertisement[/b]\n8. Intermediate conclusion 1 gives the advertisement a relevant product and audience.\n9. Add one visible choice that gains Attention.\n10. Add one visible choice that develops Interest in the product.\n11. Add one visible choice that creates Desire by showing a relevant benefit.\n12. Add one visible Action that tells the audience what to do next.\n13. Use a visual technique that supports these four choices and the intended message.\nIntermediate conclusion 2: the advertisement is likely to communicate a coherent message about the product.\n\n[b]Advertisement and credible offer[/b]\n14. Intermediate conclusion 2 provides the message that the offer must support.\n15. Choose a price that suits the audience and display that price in the advertisement.\n16. Choose and lock a market route that is likely to reach the audience.\n17. Add a specific proof point that supports the main claim.\nIntermediate conclusion 3: the advertisement is likely to present a credible offer to its audience.\n\n[b]Final judgement[/b]\n18. Intermediate conclusions 1, 2 and 3 provide the basis for the final review.\n19. Confirm all five review statements: audience suitability, clear value and price, complete AIDA choices, a supporting visual technique, and a claim supported by a proof point.\n20. Build the market card only after all five statements are confirmed.\n21. In the gallery, score every other advertisement from 0 to 2 on the same five criteria. Add the five scores to produce a total out of 10.\n22. If totals are equal, compare audience suitability first, then the combined AIDA judgement.\n23. Award Gold, Silver and Bronze to three different advertisements according to that ranking.\n\n[b]Overall conclusion[/b]\nTherefore, a campaign that completes each linked step is likely to communicate an effective and credible offer to its audience, and the shared scoring process is likely to produce a fair comparison."

