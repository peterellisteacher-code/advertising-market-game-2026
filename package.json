{
  "name": "advertising-market-creator-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npxnetlify dev",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:build-web": "node --test scripts/build-web.test.mjs scripts/godot-bridge-contract.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:studio": "vite build",
    "build:web": "node scripts/build-web.mjs --require-product-shells --require-product-builder",
    "verify:export": "node scripts/verify-web-export.mjs build/web",
    "build": "tsc --noEmit && vitest run && node --test scripts/build-web.test.mjs scripts/godot-bridge-contract.test.mjs && vite build && node scripts/build-web.mjs --require-product-shells --require-product-builder && node scripts/verify-web-export.mjs build/web"
  },
  "dependencies": {
    "fabric": "7.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@netlify/functions": "5.3.0",
    "@testing-library/dom": "10.4.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "netlify": "26.2.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
